<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Ticket <%= booking.booking_ref %> - ADA Transport Go</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: #f0f2f5;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .ticket {
            display: flex;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            width: 850px;
            max-width: 100%;
            position: relative;
        }

        /* Watermark Pattern */
        .ticket::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: radial-gradient(#ff007f 1px, transparent 1px);
            background-size: 20px 20px;
            opacity: 0.05;
            z-index: 0;
            pointer-events: none;
        }

        .left {
            flex: 2.5;
            padding: 40px;
            background-color: #fff;
            position: relative;
            z-index: 1;
            border-right: 3px dashed #e0e0e0;
        }

        .right {
            flex: 1;
            padding: 30px;
            background-color: #fffafb;
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
        }

        /* The cut-out circle effect at top and bottom of the dashed line */
        .left::before,
        .left::after {
            content: '';
            position: absolute;
            right: -17px;
            width: 30px;
            height: 30px;
            background-color: #f0f2f5;
            border-radius: 50%;
            z-index: 2;
        }

        .left::before {
            top: -15px;
        }

        .left::after {
            bottom: -15px;
        }

        .logo {
            font-size: 28px;
            font-weight: 700;
            color: #ff007f;
            margin-bottom: 30px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .data-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .data-item .label {
            font-size: 12px;
            color: #888;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .data-item .value {
            font-size: 18px;
            font-weight: 700;
            color: #222;
        }

        .footer-left {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 40px;
            border-top: 2px solid #ff007f;
            padding-top: 15px;
        }

        .status {
            font-size: 16px;
            font-weight: 700;
            color: #ff007f;
        }

        .cs {
            font-size: 12px;
            color: #555;
            text-align: right;
        }

        /* Right side */
        .right-title {
            font-size: 24px;
            font-weight: 700;
            color: #ff007f;
            letter-spacing: 2px;
            margin-bottom: 20px;
        }

        .qr-box {
            background: white;
            padding: 10px;
            border: 2px solid #ff007f;
            border-radius: 10px;
            width: 150px;
            height: 150px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .qr-box img {
            width: 100%;
            height: 100%;
        }

        .booking-id {
            font-size: 14px;
            font-weight: 700;
            margin-top: 20px;
            color: #333;
        }

        .scan-text {
            font-size: 11px;
            color: #888;
            margin-top: 5px;
        }

        .print-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            padding: 10px 20px;
            background-color: #ff007f;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
        }

        @media print {
            body {
                background: white;
                padding: 0;
            }

            .ticket {
                box-shadow: none;
                border: 1px solid #ddd;
            }

            .print-btn {
                display: none;
            }
        }

        @media screen and (max-width: 768px) {
            body {
                flex-direction: column;
                justify-content: flex-start;
                padding-top: 40px;
            }

            .ticket {
                flex-direction: column;
                width: 100%;
                max-width: 450px;
            }

            .left {
                border-right: none;
                border-bottom: 3px dashed #e0e0e0;
                padding: 30px 20px;
            }

            .data-grid {
                grid-template-columns: 1fr;
                gap: 15px;
            }

            .left::before,
            .left::after {
                top: auto;
                bottom: -16px;
                background-color: #f0f2f5;
            }

            .left::before {
                left: -16px;
                right: auto;
            }

            .left::after {
                right: -16px;
                left: auto;
            }

            .right {
                padding-top: 30px;
                padding-bottom: 40px;
            }

            .print-btn {
                position: relative;
                top: 0;
                right: 0;
                margin-bottom: 20px;
                max-width: 450px;
                width: 100%;
                text-align: center;
            }
        }
    </style>
</head>

<body>

    <button class="print-btn" onclick="window.print()">Cetak Tiket</button>

    <div class="ticket">
        <div class="left">
            <div class="logo">ADA Transport Go</div>

            <div class="data-grid">
                <div class="data-item">
                    <div class="label">Nama Pemesan</div>
                    <div class="value">
                        <%= booking.customer_name %>
                    </div>
                </div>
                <div class="data-item">
                    <div class="label">Waktu & Tanggal</div>
                    <div class="value">
                        <%= booking.date %> - <%= booking.time %> WIB
                    </div>
                </div>
                <div class="data-item">
                    <div class="label">Layanan</div>
                    <div class="value">
                        <%= booking.type %>
                    </div>
                </div>
                <div class="data-item">
                    <div class="label">Rute/Destinasi</div>
                    <div class="value">
                        <%= booking.detail %>
                    </div>
                </div>
                <div class="data-item">
                    <div class="label">Jumlah</div>
                    <div class="value">
                        <%= booking.passengers %> Orang
                    </div>
                </div>
                <div class="data-item">
                    <div class="label">Total Harga</div>
                    <div class="value">
                        <%= booking.price %>
                    </div>
                </div>
            </div>

            <div class="footer-left">
                <div class="status">Status: LUNAS</div>
                <div class="cs">CS: +62 823-3464-2165<br>www.adatransportgo.com</div>
            </div>
        </div>

        <div class="right">
            <div class="right-title">E-TICKET</div>
            <div class="qr-box">
                <img src="<%= qrImage %>" alt="QR Code">
            </div>
            <div class="booking-id">Booking ID: <%= booking.booking_ref %>
            </div>
            <div class="scan-text">Scan untuk Validasi</div>
        </div>
    </div>

</body>

</html>