<%- include('../layouts/header') %>

    <div class="container" style="margin-top: 40px; margin-bottom: 40px; min-height: 60vh;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <h2 style="color: #ff007f; margin: 0;"><i class="fas fa-inbox"></i> Kotak Masuk (Saran & Pesan)</h2>
            <a href="/admin" class="btn btn-secondary" style="padding: 10px 20px;"><i class="fas fa-arrow-left"></i>
                Kembali ke Dashboard</a>
        </div>

        <div style="background: white; padding: 25px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
            <% if (messages && messages.length> 0) { %>
                <div style="display: grid; grid-template-columns: 1fr; gap: 20px;">
                    <% messages.forEach(msg=> { %>
                        <div
                            style="border-left: 4px solid var(--primary-color); padding: 20px; background-color: #f9f9f9; border-radius: 0 10px 10px 0;">
                            <div
                                style="display: flex; justify-content: space-between; margin-bottom: 10px; border-bottom: 1px solid #ddd; padding-bottom: 10px;">
                                <div>
                                    <h4 style="margin: 0; color: #333;"><i class="fas fa-user-circle"></i>
                                        <%= msg.name %>
                                    </h4>
                                    <div style="font-size: 13px; color: #666; margin-top: 5px;">
                                        <i class="fas fa-envelope"></i> <a href="mailto:<%= msg.email %>"
                                            style="color: var(--primary-color); text-decoration: none;">
                                            <%= msg.email %>
                                        </a> |
                                        <i class="fas fa-phone"></i> <a href="https://wa.me/<%= msg.phone %>"
                                            target="_blank" style="color: #25D366; text-decoration: none;">
                                            <%= msg.phone %>
                                        </a>
                                    </div>
                                </div>
                                <div
                                    style="text-align: right; font-size: 12px; color: #999; display: flex; align-items: center; justify-content: flex-end; gap: 10px;">
                                    <% const d=new Date(msg.created_at); const dateStr=d.toLocaleDateString('id-ID', {
                                        day: 'numeric' , month: 'long' , year: 'numeric' }); const
                                        timeStr=d.toLocaleTimeString('id-ID', { hour: '2-digit' , minute:'2-digit' });
                                        %>
                                        <span><i class="far fa-clock"></i>
                                            <%= dateStr %> &bull; <%= timeStr %>
                                        </span>
                                        <form action="/admin/messages/delete/<%= msg.id %>" method="POST"
                                            style="display:inline;"
                                            onsubmit="return confirm('Apakah Anda yakin ingin menghapus pesan tanggapan ini?');">
                                            <button type="submit"
                                                style="background: none; border: none; color: #ff4b4b; font-size: 14px; cursor: pointer;"
                                                title="Hapus Pesan">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                </div>
                            </div>
                            <div style="color: #444; line-height: 1.6; font-size: 15px; white-space: pre-wrap;">
                                <%= msg.message %>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } else { %>
                    <div style="text-align: center; padding: 50px 20px; color: #888;">
                        <i class="fas fa-envelope-open-text fa-4x" style="color: #ddd; margin-bottom: 20px;"></i>
                        <h3>Belum ada pesan masuk</h3>
                        <p>Pesan atau saran pelanggan dari formulir halaman kontak akan muncul di sini.</p>
                    </div>
                    <% } %>
        </div>
    </div>

    <%- include('../layouts/footer') %>