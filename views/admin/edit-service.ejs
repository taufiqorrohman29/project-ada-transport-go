<%- include('../layouts/header') %>

    <div class="container" style="margin-top: 40px; margin-bottom: 40px; min-height: 60vh;">
        <h2 style="margin-bottom: 20px; color: #ff007f; text-transform: capitalize;">Edit <%= type %>
        </h2>
        <a href="/admin" class="btn btn-secondary"
            style="margin-bottom: 20px; display:inline-block; padding: 8px 15px; background: #333; color: white; border-radius: 5px; text-decoration: none;"><i
                class="fas fa-arrow-left"></i> Kembali ke Dashboard</a>

        <div
            style="background: white; padding: 25px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); max-width: 600px;">
            <form action="/admin/edit/<%= type %>/<%= item.id %>" method="POST" enctype="multipart/form-data">

                <% if (type==='vehicles' ) { %>
                    <div class="form-group" style="margin-bottom: 15px;">
                        <label style="display:block; margin-bottom: 5px; color:#555;">Nama Kendaraan</label>
                        <input type="text" name="name" value="<%= item.name %>" required
                            style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                    </div>
                    <div class="form-group" style="margin-bottom: 15px;">
                        <label style="display:block; margin-bottom: 5px; color:#555;">Kapasitas (Contoh: '15
                            seat')</label>
                        <input type="text" name="capacity" value="<%= item.capacity %>" required
                            style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                    </div>
                    <div class="form-group" style="margin-bottom: 15px;">
                        <label style="display:block; margin-bottom: 5px; color:#555;">Harga per hari (Rp)</label>
                        <input type="number" name="price" value="<%= item.price %>" required
                            style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                    </div>
                    <div class="form-group" style="margin-bottom: 15px;">
                        <label style="display:block; margin-bottom: 5px; color:#555;">Gambar Kendaraan Baru (Biarkan
                            kosong jika tetap)</label>
                        <input type="file" name="image" accept="image/*"
                            style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                        <p style="font-size: 12px; color: #888; margin-top:5px;">Gambar saat ini terpasang.</p>
                    </div>
                    <% } else if (type==='intercity' ) { %>
                        <div class="form-group" style="margin-bottom: 15px;">
                            <label style="display:block; margin-bottom: 5px; color:#555;">Rute Utama</label>
                            <input type="text" name="name" value="<%= item.name %>" required
                                style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                        </div>
                        <div class="form-group" style="margin-bottom: 15px;">
                            <label style="display:block; margin-bottom: 5px; color:#555;">Rute Lengkap</label>
                            <input type="text" name="route_desc" value="<%= item.route_desc %>" required
                                style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                        </div>
                        <div class="form-group" style="margin-bottom: 15px;">
                            <label style="display:block; margin-bottom: 5px; color:#555;">Harga (Rp)</label>
                            <input type="number" name="price" value="<%= item.price %>" required
                                style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                        </div>
                        <div class="form-group" style="margin-bottom: 15px;">
                            <label style="display:block; margin-bottom: 5px; color:#555;">Ganti Gambar Rute 1 (Biarkan
                                kosong jika tetap)</label>
                            <input type="file" name="image_1" accept="image/*"
                                style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                        </div>
                        <div class="form-group" style="margin-bottom: 15px;">
                            <label style="display:block; margin-bottom: 5px; color:#555;">Ganti Gambar Rute 2 (Biarkan
                                kosong jika tetap)</label>
                            <input type="file" name="image_2" accept="image/*"
                                style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                        </div>
                        <% } else if (type==='tourism' ) { %>
                            <div class="form-group" style="margin-bottom: 15px;">
                                <label style="display:block; margin-bottom: 5px; color:#555;">Nama Paket</label>
                                <input type="text" name="name" value="<%= item.name %>" required
                                    style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                            </div>
                            <div class="form-group" style="margin-bottom: 15px;">
                                <label style="display:block; margin-bottom: 5px; color:#555;">Durasi</label>
                                <input type="text" name="duration" value="<%= item.duration %>" required
                                    style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                            </div>
                            <div class="form-group" style="margin-bottom: 15px;">
                                <label style="display:block; margin-bottom: 5px; color:#555;">Destinasi Inti</label>
                                <input type="text" name="destinations" value="<%= item.destinations %>" required
                                    style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                            </div>
                            <div class="form-group" style="margin-bottom: 15px;">
                                <label style="display:block; margin-bottom: 5px; color:#555;">Harga Mulai (Rp)</label>
                                <input type="number" name="price" value="<%= item.price %>" required
                                    style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                            </div>
                            <div class="form-group" style="margin-bottom: 15px;">
                                <label style="display:block; margin-bottom: 5px; color:#555;">Ganti Gambar Destinasi 1
                                    (Kosongkan jika tetap)</label>
                                <input type="file" name="image_1" accept="image/*"
                                    style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                            </div>
                            <div class="form-group" style="margin-bottom: 15px;">
                                <label style="display:block; margin-bottom: 5px; color:#555;">Ganti Gambar Destinasi 2
                                    (Kosongkan jika tetap)</label>
                                <input type="file" name="image_2" accept="image/*"
                                    style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                            </div>
                            <% } %>

                                <button type="submit" class="btn btn-primary"
                                    style="width: 100%; margin-top:20px; padding: 12px; font-size: 16px;">Simpan
                                    Perubahan</button>
            </form>
        </div>
    </div>

    <%- include('../layouts/footer') %>