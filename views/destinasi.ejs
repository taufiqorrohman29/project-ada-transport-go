<%- include('layouts/header') %>

    <!-- Destinations Section -->
    <section id="destinations" class="destinations">
        <div class="container">
            <h2 class="section-title">DESTINASI POPULAR</h2>
            <div class="destinations-grid">
                <div class="destination-card">
                    <div class="destination-image">
                        <img src="/image destination/Bali.jpg" alt="Bali">
                    </div>
                    <div class="destination-content">
                        <h3>Bali</h3>
                        <p>Pulau Dewata dengan keindahan alam dan budaya yang memukau</p>
                    </div>
                </div>
                <div class="destination-card">
                    <div class="destination-image">
                        <img src="/image destination/yogyakarta.jpg" alt="Yogyakarta">
                    </div>
                    <div class="destination-content">
                        <h3>Yogyakarta</h3>
                        <p>Kota budaya dengan sejarah dan keindahan candi-candi</p>
                    </div>
                </div>
                <div class="destination-card">
                    <div class="destination-image">
                        <img src="/image destination/magetan.jpg" alt="Magetan">
                    </div>
                    <div class="destination-content">
                        <h3>Magetan</h3>
                        <p>Kabupaten dengan keindahan alam pegunungan yang memukau</p>
                    </div>
                </div>
                <div class="destination-card">
                    <div class="destination-image">
                        <img src="/image destination/Malang.jpg" alt="Malang">
                    </div>
                    <div class="destination-content">
                        <h3>Malang</h3>
                        <p>Kota dengan udara sejuk dan berbagai destinasi wisata menarik</p>
                    </div>
                </div>
                <div class="destination-card">
                    <div class="destination-image">
                        <img src="/image destination/ziarahwali.jpg" alt="Ziarah Wali">
                    </div>
                    <div class="destination-content">
                        <h3>Ziarah Wali</h3>
                        <p>Paket wisata religi ke makam para wali songo</p>
                    </div>
                </div>
            </div>
        </div>
