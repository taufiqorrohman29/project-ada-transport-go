<%- include('layouts/header') %>

    <div class="container" style="min-height: 50vh; display: flex; align-items: center; justify-content: center;">
        <div
            style="background: white; padding: 40px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); max-width: 400px; width: 100%;">
            <h2 style="text-align: center; margin-bottom: 20px;">Lupa Password</h2>
            <% if (typeof message !=='undefined' && message) { %>
                <div
                    style="background: #2a9d8f; color: white; padding: 10px; border-radius: 5px; margin-bottom: 20px; text-align: center;">
                    <%= message %>
                </div>
                <% } %>
                    <form action="/api/auth/forgot-password" method="POST">
                        <div class="form-group" style="margin-bottom: 20px;">
                            <label>Email yang terdaftar</label>
                            <input type="email" name="email" required
                                style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; margin-top: 5px;">
                        </div>
                        <button type="submit" class="btn btn-primary" style="width: 100%;">Kirim Link Reset</button>
                    </form>
        </div>
    </div>

    <%- include('layouts/footer') %>